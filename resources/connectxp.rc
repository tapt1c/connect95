#include <windows.h>
#include "resource.h"
1 RT_MANIFEST "connectxp.manifest"
IDI_APP ICON "connectxp.ico"
IDB_BATTERY_STRIP BITMAP "battery.bmp"
101 ICON "phone.ico"
102 ICON "send.ico"
103 ICON "ring.ico"
104 ICON "clipboard.ico"
1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileDescription", "ConnectXP\0"
   VALUE "ProductName", "ConnectXP\0"
   VALUE "FileVersion", "1.0.0\0"
   VALUE "ProductVersion", "1.0.0\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END

IDD_DEVICE_NAME DIALOGEX 0, 0, 250, 100
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "PC device name"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT "Shown in KDE Connect on your phone. An idle connection reconnects after saving.", IDC_NAME_DESCRIPTION, 10, 10, 230, 24
    LTEXT "Device name (up to 32 characters)", IDC_NAME_LABEL, 10, 38, 230, 10
    EDITTEXT IDC_DEVICE_NAME, 10, 50, 230, 14, ES_AUTOHSCROLL
    DEFPUSHBUTTON "Save", IDOK, 124, 77, 55, 14
    PUSHBUTTON "Cancel", IDCANCEL, 185, 77, 55, 14
END
